# OCI API signing credentials
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=C:\\path\\to\\oci_api_key.pem
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_REGION=ap-tokyo-1

# Target resources
OCI_COMPARTMENT_OCID=
OCI_SUBNET_OCID=
# Optional override. Leave blank to auto-select the latest matching platform image.
OCI_IMAGE_OCID=
OCI_IMAGE_OS=Canonical Ubuntu
OCI_IMAGE_OS_VERSION=24.04 Minimal aarch64

# Optional. Leave blank to automatically use the first AD in the compartment.
OCI_AVAILABILITY_DOMAIN=

# SSH public key inserted into the created Ubuntu VM
SSH_PUBLIC_KEY_PATH=C:\\path\\to\\ssh-key.key.pub

# Instance
INSTANCE_DISPLAY_NAME=GMT-Server
INSTANCE_SHAPE=VM.Standard.A1.Flex
INSTANCE_OCPUS=4
INSTANCE_MEMORY_GB=24
ASSIGN_PUBLIC_IP=true

# Retry only when OCI reports capacity shortage
RETRY_SECONDS=600
